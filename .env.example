# Aplicação
NODE_ENV="production"
PORT="3000"
DOMAIN="participativa.exemplo.org"
APP_ORIGIN="https://participativa.exemplo.org"
APP_URL="https://participativa.exemplo.org"
ENABLE_PUBLIC_REGISTRATION="true"
ENABLE_PUBLIC_DEMAND_INTAKE="true"

# Segurança e privacidade obrigatórias em produção
JWT_SECRET="troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres"
LGPD_CONSENT_VERSION="2026-09-v1"
DPO_CONTACT_EMAIL="privacidade@exemplo.org"

# Persistência de produção — Vercel + Supabase/Postgres
# DATABASE_URL deve ser a conexão Postgres usada somente no backend.
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"
SUPABASE_URL="https://projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_EVIDENCE_BUCKET="evidencias-demandas"
# Backup de produção NÃO usa filesystem da Vercel. Validar backup/PITR/rotação no provedor Postgres/Supabase.
PRODUCTION_BACKUP_MODE="provider-managed"

# Retenção e minimização P0-C
RETENTION_CLOSED_DEMAND_CONTACT_DAYS="180"
RETENTION_CLOSED_DEMAND_EVIDENCE_DAYS="365"
RETENTION_INACTIVE_ACCOUNT_DAYS="730"
RETENTION_AUDIT_LOG_DAYS="1825"
RETENTION_AGGREGATE_ANALYTICS_DAYS="730"
CIVIC_AGGREGATE_MIN_GROUP_SIZE="5"

# Compatibilidade local/testes SQLite — não configurar como persistência de produção na Vercel
CIVIC_DB_PATH="./civic_platform.db"
EVIDENCE_DIR="./evidence"
BACKUP_DIR="./backups-local"
BACKUP_EXTERNAL_DIR="./backups-external"

# Gemini: somente backend. Nunca expor via Vite/client bundle.
GEMINI_API_KEY=""

# Administrador privado. Em produção, o cadastro deve existir em private.admins no Postgres.
ADMIN_EMAIL="admin@exemplo.org"
ADMIN_PASSWORD="troque-por-uma-senha-forte-com-12-ou-mais-caracteres"
ADMIN_NAME="Administrador"

# Atualização automática do núcleo de inteligência.
INTELLIGENCE_AUTO_REFRESH="true"
INTELLIGENCE_REFRESH_INTERVAL_MINUTES="360"

# Fontes públicas de dados usadas pelo núcleo de inteligência
CMM_SAPL_API_BASE="https://sapl.cmm.am.gov.br/api"
IBGE_POPULATION_API_URL="https://apisidra.ibge.gov.br/values/t/6579/n6/1302603/v/9324/p/last%201?formato=json"
SICONFI_API_URL="https://apidatalake.tesouro.gov.br/ords/siconfi/tt"
PNCP_API_URL="https://pncp.gov.br/api/consulta/v1"
PNCP_PAGE_SIZE="100"
PNCP_MAX_PAGES_PER_ENTITY="15"
PNCP_TIMEOUT_MS="18000"
PNCP_RETRY_ATTEMPTS="3"
MANAUS_INSTITUTIONS_JSON=""
OBRASGOV_API_URL="https://api-publica.obrasgov.gestao.gov.br/obras"
CNES_DATASUS_API_URL="https://apidadosabertos.saude.gov.br/cnes/estabelecimentos"
CNES_PAGE_SIZE="20"
CNES_MAX_PAGES="100"
CNES_DATASUS_API_TOKEN=""
CNES_DATASUS_CATALOG_URL=""
INEP_CENSO_ESCOLAR_API_URL=""
INEP_CENSO_ESCOLAR_FILE=""
TCE_AM_API_URL="https://econtasapi.tce.am.gov.br"
TCE_AM_API_TOKEN=""
TCE_AM_CLIENT_ID=""
TCE_AM_USERNAME=""
TCE_AM_PASSWORD=""
TCE_AM_MAX_UNITS="30"
MANAUS_TRANSPARENCIA_API_URL=""
