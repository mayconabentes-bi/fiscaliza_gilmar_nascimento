# Ambiente privado do administrador
NODE_ENV="production"
PORT="3000"
DOMAIN="localhost"
APP_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"

# A experiência pública pode ser aberta ou fechada independentemente do núcleo privado.
ENABLE_PUBLIC_REGISTRATION="true"
ENABLE_PUBLIC_DEMAND_INTAKE="true"

# Gere valores próprios, independentes, aleatórios e com 32+ caracteres.
JWT_SECRET="gere-uma-chave-interna-aleatoria-com-32-ou-mais-caracteres"
LGPD_CONSENT_VERSION="private-v1"
DPO_CONTACT_EMAIL="privacidade@seu-dominio.org"

# Persistência
CIVIC_DB_PATH="./data/private/civic_platform.db"
EVIDENCE_DIR="./data/private/evidence"
BACKUP_DIR="./data/private/backups-local"
BACKUP_EXTERNAL_DIR="./data/private/backups-external"

# Único administrador privado. Não existe cadastro de admin na aplicação.
ADMIN_EMAIL="admin@seu-dominio.org"
ADMIN_PASSWORD="Substitua-Por-Uma-Senha-Forte-Unica-123!"
ADMIN_NAME="Administrador"

# IA opcional; chave somente no backend
GEMINI_API_KEY=""

# Fontes públicas de dados usadas pelo Radar Territorial
CMM_SAPL_API_BASE="https://sapl.cmm.am.gov.br/api"
MANAUS_TRANSPARENCIA_API_URL=""
TCE_AM_API_URL=""
OBRASGOV_API_URL=""
